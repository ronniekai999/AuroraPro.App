#!/usr/bin/env bash
# Advisory check for the adversarial review gate. NOT the boundary.
#
# core.hooksPath is per-clone config the pushing process controls, so
# `git -c core.hooksPath=/dev/null push`, a throwaway clone, or one
# `git config` disables this in a single token. It exists to catch honest
# mistakes early, not to stop anyone. See CLAUDE.md for what actually binds.
#
# git runs this after the shell has already resolved everything: the repo is
# unambiguous ($GIT_DIR is set by git itself), and the exact refs and shas
# being pushed arrive on stdin. Nothing about how the command was typed can
# change what this sees.
#
# Within its reach it is at least unambiguous: the PreToolUse hook that used
# to hold this role tried to recognize a push by parsing the shell command, and four
# review rounds walked through it: `git push;`, `git push&&x`, `git -c k=v
# push`, `env FOO=1 git push`, `bash -c "git push"`, `bash -c 'echo x; git
# push'`, `pushd other && git push`, `cd other && git push`, `sudo -i git
# push`, `timeout -k 5 60 git push`, `git -C $(pwd) push`, `ssh box 'cd /srv
# && git push'`, and two pushes in one call where only the first was checked.
# Each fix was correct and each left the next one reachable, because an
# allowlist of shell shapes cannot be finished. This layer has no such list.
#
# stdin: <local ref> <local sha> <remote ref> <remote sha>, one per ref.
# Exit non-zero to refuse the push.
#
# Installed via core.hooksPath=.githooks (see scripts/install-git-hooks.sh,
# run automatically by the SessionStart hook in .claude/settings.json).
# `git push --no-verify` skips ALL pre-push hooks — that is git's design, not
# a hole in this script — so the PreToolUse hook refuses --no-verify
# separately, and a bypass that gets past both still has to be reported.

set -uo pipefail

ZERO='0000000000000000000000000000000000000000'

# Fail CLOSED when the repo shape is unexpected. `--show-toplevel` exits 128
# in a bare repo, and `|| exit 0` there made the first line of the gate its
# most reliable bypass: pushing from a bare clone was simply allowed.
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
  REPO_ROOT="$(git rev-parse --git-dir 2>/dev/null)"
fi
if [ -z "$REPO_ROOT" ]; then
  echo "review-gate: BLOCKED — cannot resolve this repository, so the review gate cannot verify the push." >&2
  exit 1
fi
RECORDS_DIR="$REPO_ROOT/.claude/review-records"

if ! command -v jq >/dev/null 2>&1; then
  echo "review-gate: jq is not installed, so review records cannot be read. Failing closed." >&2
  exit 1
fi

# Base for the docs-only exemption.
base=""
for candidate in origin/main origin/master; do
  if git rev-parse --verify --quiet "$candidate" >/dev/null; then base="$candidate"; break; fi
done

# Returns 0 when every path in the range is documentation. Files that GOVERN
# agent behavior are excluded: the rules an agent follows are not a place for
# unreviewed edits.
docs_only() {
  local from="$1" to="$2" changed
  # No base at all — a brand-new repo or an unrelated first push. Diff
  # against the empty tree so the commit's whole file list is still
  # inspectable, rather than failing closed on a legitimate docs push.
  [ -n "$from" ] || from="$(git hash-object -t tree /dev/null)"
  [ -n "$from" ] || return 1
  # --no-renames is load-bearing: with rename detection on, `git diff
  # --name-only` prints only the DESTINATION path, so `git mv internal/db/q.go
  # docs/q.md` reads as a docs-only change. A reviewer deleted this hook, the
  # PreToolUse hook, and Go source from a remote through exactly that.
  changed="$(git diff --no-renames --name-only "$from" "$to" 2>/dev/null)" || return 1
  # An empty diff is not evidence of a docs-only change — `from` is computed
  # from a remote-tracking ref the pusher can rewrite locally
  # (`git update-ref refs/remotes/origin/main <any-sha>`), which made any
  # commit look like a no-op. Fail closed and let the record check decide.
  [ -n "$changed" ] || return 1
  changed="$(printf '%s\n' "$changed" | grep -v '^\.claude/review-records/.*\.json$')"
  [ -n "$changed" ] || return 0
  # NOTE: stripping records from the CUMULATIVE diff is not what makes a
  # record commit pushable — the code is still in the range. The record is
  # resolved by walking back over record-only commits below; see
  # effective_commit().
  printf '%s\n' "$changed" | grep -qvE '\.(md|txt)$' && return 1
  printf '%s\n' "$changed" | grep -qE '(^|/)(CLAUDE|AGENTS)\.md$|^docs/dev-workflow\.md$' && return 1
  return 0
}

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion

  from=""
  if [ -n "${remote_sha:-}" ] && [ "$remote_sha" != "$ZERO" ]; then
    from="$remote_sha"                            # only the new commits
  elif [ -n "$base" ]; then
    from="$(git merge-base "$base" "$local_sha" 2>/dev/null || true)"
  fi
  # Resolve the commit a review DESCRIBES, walking back over commits that
  # only add review records. Recording a review moves HEAD (records are
  # tracked so CI can read them), so keying on the raw tip made the record
  # commit itself unpushable — the flow AGENTS.md documents blocked on its
  # own last step.
  effective="$local_sha"
  while [ "$effective" != "${from:-}" ]; do
    parent="$(git rev-parse --verify --quiet "${effective}^" 2>/dev/null)" || break
    [ -n "$parent" ] || break
    ec="$(git diff --no-renames --name-only "$parent" "$effective" 2>/dev/null)"
    [ -n "$ec" ] || break
    printf '%s\n' "$ec" | grep -qvE '^\.claude/review-records/.*\.json$' && break
    effective="$parent"
  done

  sha="$effective"
  if ! docs_only "$from" "$sha"; then

    record="$RECORDS_DIR/$sha.json"
    if [ ! -f "$record" ]; then
      echo "review-gate: BLOCKED — no review on record for $sha ($(git log -1 --format=%s "$sha" 2>/dev/null))." >&2
      blocked=1
      continue
    fi
    verdict="$(jq -r '.verdict // ""' "$record" 2>/dev/null)" || verdict=""
    recorded_sha="$(jq -r '.sha // ""' "$record" 2>/dev/null)" || recorded_sha=""
    reviewer="$(jq -r '.reviewer // ""' "$record" 2>/dev/null)" || reviewer=""

    if [ "$recorded_sha" != "$sha" ]; then
      echo "review-gate: BLOCKED — the record for $sha describes ${recorded_sha:-nothing}. Re-record." >&2
      blocked=1; continue
    fi
    case "$verdict" in
      clean|lows-only)
        if [ -z "$reviewer" ]; then
          echo "review-gate: BLOCKED — the record for $sha names no reviewer. Re-record with --reviewer <id>." >&2
          blocked=1
        fi
        ;;
      bypass)
        echo "review-gate: BYPASSED for $sha — NO review happened. Report the gate as INCOMPLETE in your handoff and on the PR." >&2
        ;;
      "")
        echo "review-gate: BLOCKED — the record for $sha has no verdict. Re-record." >&2; blocked=1 ;;
      *)
        echo "review-gate: BLOCKED — the review for $sha has verdict \"$verdict\". Resolve the findings, re-review the final diff, re-record." >&2
        blocked=1 ;;
    esac
  fi
done

if [ "$blocked" = 1 ]; then
  cat >&2 <<'EOF'

This repo requires an independent adversarial review before code is pushed
(AGENTS.md "Mandatory independent adversarial review"; docs/dev-workflow.md
stage 5). A self-review by the implementing agent does NOT satisfy it.

  1. Dispatch a SEPARATE, fresh-context, read-only reviewer over the full
     diff. Do not prime it with your own conclusions.
  2. Resolve every high/critical finding, then re-review the FINAL diff.
  3. bash scripts/record-review.sh clean --reviewer <id> --findings <n> "<summary>"

Records are keyed to the exact commit, so amending or adding one invalidates
them. If no reviewer is available the gate is INCOMPLETE — say so plainly;
`record-review.sh bypass` records that honestly.
EOF
  exit 1
fi
exit 0
