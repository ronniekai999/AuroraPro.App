      "message": "{\"id\":8171,\"library_id\":2,\"type\":\"movie\",\"title\":\"The Rocky Horror Picture Show\",\"sort_title\":\"Rocky Horror Picture Show\",\"year\":1975,\"overview\":\"After getting a flat tire in the middle of nowhere, newly engaged couple Brad and Janet encounter the eerie mansion of the flamboyant, seductive Dr Frank-N-Furter and a variety of eccentric characters. Through elaborate dance and rock music, the mad scientist unveils his latest creation: a perfect, muscular man.\",\"rating\":7.4,\"runtime_minutes\":100,\"content_rating\":\"R\",\"poster_path\":\"/3pyE6ZqDbuJi7zrNzzQzcKTWdmN.jpg\",\"backdrop_path\":\"/a53EGF0NzHRGKuRItsrtXBM8FCD.jpg\",\"added_at\":\"2026-04-29T22:44:04.923303Z\",\"updated_at\":\"2026-04-29T22:44:06.140531Z\",\"genres\":[\"Comedy\",\"Fantasy\",\"Horror\",\"Science Fiction\"],\"files\":[{\"id\":7425,\"media_item_id\":8171,\"size_bytes\":19480877374,\"container\":\"mkv\",\"video_codec\":\"hevc\",\"audio_codec\":\"truehd\",\"resolution\":\"3584x2160\",\"version_tag\":\"4K\",\"bitrate\":25955538,\"duration_ms\":6004384,\"video_profile\":\"Main 10\",\"video_pix_fmt\":\"yuv420p10le\",\"file_hash\":\"128b8e8c46126f5db56f4c280b3cbb0e\",\"scanned_at\":\"2026-04-29T22:44:05.77167Z\",\"audio_tracks\":[{\"index\":0,\"codec\":\"truehd\",\"channels\":8,\"language\":\"eng\",\"is_default\":true},{\"index\":1,\"codec\":\"ac3\",\"channels\":6,\"language\":\"eng\",\"is_default\":true},{\"index\":2,\"codec\":\"ac3\",\"channels\":2,\"language\":\"eng\",\"title\":\"Commentary\",\"is_default\":false}],\"subtitle_tracks\":[{\"index\":0,\"language\":\"eng\",\"title\":\"English SDH\",\"codec\":\"hdmv_pgs_subtitle\",\"forced\":false,\"default\":false},{\"index\":1,\"language\":\"fre\",\"title\":\"French\",\"codec\":\"hdmv_pgs_subtitle\",\"forced\":false,\"default\":false},{\"index\":2,\"language\":\"spa\",\"title\":\"Spanish\",\"codec\":\"hdmv_pgs_subtitle\",\"forced\":false,\"default\":false},{\"index\":3,\"language\":\"spa\",\"title\":\"Spanish\