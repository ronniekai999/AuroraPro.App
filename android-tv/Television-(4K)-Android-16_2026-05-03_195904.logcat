      "message": "{\"data\":[{\"id\":8183,\"library_id\":1,\"type\":\"movie\",\"title\":\"The Wizard of the Kremlin\",\"sort_title\":\"Wizard of the Kremlin\",\"year\":2026,\"overview\":\"In early 1990s Russia, amid post-Soviet chaos, brilliant young Vadim Baranov charts his path. First an artist, then a reality television producer, he becomes the spin doctor to rising KGB agent Vladimir Putin. At the heart of power, Baranov shapes the new Russia, blurring the boundaries between truth and lies, belief and manipulation. Only the magnetic Ksenia is beyond his control, tempting him away from this dangerous game. Years later, after retreating into silence and shrouded in mystery, Baranov finally reveals the dark secrets of the regime he helped build.\",\"rating\":6.5,\"runtime_minutes\":136,\"content_rating\":\"R\",\"poster_path\":\"/l8eEJ6iQPGLala7Oo43LTYb31fM.jpg\",\"backdrop_path\":\"/ArlN8C4VnVbDkwD7qLj9YAob1G4.jpg\",\"added_at\":\"2026-05-02T04:08:16.018779Z\",\"updated_at\":\"2026-05-02T04:08:16.607501Z\",\"genres\":[\"Comedy\",\"Drama\",\"Thriller\"],\"file_path\":\"\"},{\"id\":8182,\"library_id\":1,\"type\":\"movie\",\"title\":\"The Pout-Pout Fish\",\"sort_title\":\"Pout Pout Fish\",\"year\":2026,\"overview\":\"Living on a rundown shipwreck, Mr. Fish one day discovers a hyperactive young sea dragon Pip – who had mistaken his home for a junkyard – pilfering his belongings. The heated argument that ensues leaves both their houses in ruin. But there is hope! Embarking on a seemingly impossible quest in search of the mythical \u0027Shimmer\u0027 to grant them a wish, there’s only one problem: someone else is on the hunt...\",\"rating\":6.1,\"runtime_minutes\":92,\"content_rating\":\"PG\",\"poster_path\":\"/fcDXgGL14qL46It1XOozEjX5Jws.jpg\",\"backdrop_path\":\"/6qQQhhF87Rm1z2TYhXAmoPiEHME.jpg\",\"added_at\":\"2026-05-02T04:08:14.597594Z\",\"updated_at\":\"2026-05-02T04:08:15.538362Z\",\"genres\":[\"Adventure\",\"Animation\",\"Comedy\",\"Family\"],\"file_path\":\"\"},{\"id\":8181,\"library_id\":1,\"type\":\"movie\",\"title\":\"Swapped\",\"sort_title\":\"Swapped\",\"year\":2026,\"overview\":\"A tiny woodland creature and a majestic bird suddenly swap bodies, forcing them to team up to survive the wildest adventure of their lives.\",\"rating\":8.8,\"runtime_minutes\":102,\"content_rating\":\"PG\",\"poster_path\":\"/tHhxWxge06goXU6ZQH1hj7vK8Hd.jpg\",\"backdrop_path\":\"/r4Tfw8CPeeI4EIHI3wH9qNkycZd.jpg\",\"added_at\":\"2026-05-02T04:08:10.730053Z\",\"updated_at\":\"2026-05-02T04:08:11.642322Z\",\"genres\":[\"Adventure\",\"Animation\",\"Comedy\",\"Family\",\"Fantasy\"],\"file_path\":\"\"},{\"id\":8171,\"library_id\":2,\"type\":\"movie\",\"title\":\"The Rocky Horror Picture Show\",\"sort_title\":\"Rocky Horror Picture Show\",\"year\":1975,\"overview\":\"After getting a flat tire in the middle of nowhere, newly engaged couple Brad and Janet encounter the eerie mansion of the flamboyant, seductive Dr Frank-N-Furter and a variety of eccentric characters. Through elaborate dance and rock music, the mad scientist unveils his latest creation: a perfect, muscular man.\",\"rating\":7.4,\"runtime_minutes\":100,\"content_rating\":\"R\",\"poster_path\":\"/3pyE6ZqDbuJi7zrNzzQzcKTWdmN.jpg\",\"backdrop_path\":\"/a53EGF0NzHRGKuRItsrtXBM8FCD.jpg\",\"added_at\":\"2026-04-29T22:44:04.923303Z\",\"updated_at\":\"2026-04-29T22:44:06.140531Z\",\"genres\":[\"Comedy\",\"Fantasy\",\"Horror\",\"Science Fiction\"],\"has_4k\":true,\"file_path\":\"\"},{\"id\":8167,\"library_id\":1,\"type\":\"movie\",\"title\":\"Forbidden Fruits\",\"sort_title\":\"Forbidden Fruits\",\"year\":2026,\"overview\":\"Free Eden employee Apple secretly runs a witchy femme cult in the basement of the mall store after hours - with fellow fruits Cherry and Fig. But when new hire Pumpkin challenges their performative sisterhood, the women are forced to face their own poisons or succumb to a bloody fate.\",\"rating\":6.8,\"runtime_minutes\":104,\"content_rating\":\"R\",\"poster_path\":\"/t3hvrrrqvRoURz4y1A1aCys6WD9.jpg\",\"backdrop_path\":\"/6xEdQND18WFuKeRNwfzMfKHoK5N.jpg\",\"added_at\":\"2026-04-29T04:09:03.175997Z\",\"updated_at\":\"2026-04-29T04:09:04.05973Z\",\"genres\":[\"Comedy\",\"Horror\"],\"file_path\":\"\"},{\"id\":8166,\"library_id\":1,\"type\":\"movie\",\"title\":\"They Will Kill You\",\"sort_title\":\"They Will Kill"
    },
