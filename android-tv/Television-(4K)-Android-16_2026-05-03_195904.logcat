      "message": "3:40:22.322773Z\",\"genres\":[\"Comedy\",\"Crime\",\"Thriller\"],\"file_path\":\"\"},{\"id\":6029,\"library_id\":1,\"type\":\"movie\",\"title\":\"Charlie the Wonderdog\",\"sort_title\":\"Charlie the Wonderdog\",\"year\":2025,\"overview\":\"Timid 9-year-old Danny teams up with his beloved family dog Charlie, who gets abducted by aliens and returns with superpowers, to thwart a plan by the neighbor\u0027s sinister cat Puddy to destroy humanity.\",\"rating\":6.2,\"runtime_minutes\":92,\"content_rating\":\"PG\",\"poster_path\":\"/whvkL0wzxgKmVbaPontq9NlVd5z.jpg\",\"backdrop_path\":\"/2skPNvhiF3B0pUigNm1L5KLWvrk.jpg\",\"added_at\":\"2026-04-18T16:49:50.768389Z\",\"updated_at\":\"2026-04-18T16:49:59.865409Z\",\"genres\":[\"Action\",\"Adventure\",\"Animation\",\"Comedy\",\"Family\"],\"file_path\":\"\"},{\"id\":5549,\"library_id\":1,\"type\":\"movie\",\"title\":\"Roommates\",\"sort_title\":\"Roommates\",\"year\":2026,\"overview\":\"When college freshman Devon asks cool, confident Celeste to be her roommate, a blossoming friendship quickly spirals into a war of passive aggression.\",\"rating\":6,\"content_rating\":\"R\",\"poster_path\":\"/eW1s6omXIfVkTlmKVe9y9Dwwt4u.jpg\",\"backdrop_path\":\"/uw9tk5NfyvQm9lX35dxsQh15NSL.jpg\",\"added_at\":\"2026-04-17T22:09:53.653282Z\",\"updated_at\":\"2026-04-18T16:59:21.371747Z\",\"genres\":[\"Comedy\"],\"file_path\":\"\"},{\"id\":4266,\"library_id\":1,\"type\":\"movie\",\"title\":\"Outcome\",\"sort_title\":\"Outcome\",\"year\":2026,\"overview\":\"Reef Hawk, Hollywood\u0027s poster child since age six, is not okay. When he learns about an extortion plot tied to a mysterious video, Reef preemptively sets out on a redemption tour to make amends, confront his demons, and avoid getting canceled.\",\"rating\":5.4,\"runtime_minutes\":84,\"content_rating\":\"R\",\"poster_path\":\"/kSzcpfbTy2pXHGvrVU2WhQTo6oU.jpg\",\"backdrop_path\":\"/avwIERZtWiWa34qShf5biDzAVaF.jpg\",\"added_at\":\"2026-04-17T03:00:57.018278Z\",\"updated_at\":\"2026-04-18T16:57:59.90239Z\",\"genres\":[\"Comedy\",\"Drama\"],\"file_path\":\"\"},{\"id\":3976,\"library_id\":1,\"type\":\"movie\",\"title\":\"Jumanji: The Next Level\",\"sort_title\":\"Jumanji The Next Level\",\"year\":2019,\"overview\":\"As the gang return to Jumanji to rescue one of their own, they discover that nothing is as they expect. The players will have to brave parts unknown and unexplored in order to escape the world’s most dangerous game.\",\"rating\":6.9,\"runtime_minutes\":123,\"content_rating\":\"PG-13\",\"poster_path\":\"/jyw8VKYEiM1UDzPB7NsisUgBeJ8.jpg\",\"backdrop_path\":\"/qgch2rFskIxDMgwrD5lWTaB4nBl.jpg\",\"added_at\":\"2026-04-17T02:58:07.488476Z\",\"updated_at\":\"2026-04-25T16:05:05.452033Z\",\"genres\":[\"Adventure\",\"Comedy\",\"Fantasy\"],\"file_path\":\"\"},{\"id\":3274,\"library_id\":1,\"type\":\"movie\",\"title\":\"Balls Up\",\"sort_title\":\"Balls Up\",\"year\":2026,\"overview\":\"Two marketing executives go \\\"balls out\\\" and pitch a bold full‑coverage condom sponsorship with the World Cup. After their drunken celebration in Brazil sparks a global scandal, they must outrun furious fans, criminals, and power-hungry officials to salvage their careers and make it home alive.\",\"rating\":5.4,\"runtime_minutes\":104,\"content_rating\":\"R\",\"poster_path\":\"/xwvJ3WzdJ1OCuDoY8LAxBUlQyig.jpg\",\"backdrop_path\":\"/jRsjWwZzI39bTm44FNhRtiICd9k.jpg\",\"added_at\":\"2026-04-17T02:51:28.79129Z\",\"updated_at\":\"2026-04-18T16:48:30.495845Z\",\"genres\":[\"Action\",\"Adventure\",\"Comedy\"],\"file_path\":\"\"},{\"id\":2333,\"library_id\":1,\"type\":\"movie\",\"title\":\"Zootopia\",\"sort_title\":\"Zootopia\",\"year\":2016,\"overview\":\"Determined to prove herself, Officer Judy Hopps, the first bunny on Zootopia\u0027s police force, jumps at the chance to crack her first case - even if it means partnering with scam-artist fox Nick Wilde to solve the mystery.\",\"rating\":7.8,\"runtime_minutes\":109,\"content_rating\":\"PG\",\"poster_path\":\"/hlK0e0wAQ3VLuJcsfIYPvb4JVud.jpg\",\"backdrop_path\":\"/9tOkjBEiiGcaClgJFtwocStZvIT.jpg\",\"added_at\":\"2026-04-08T03:56:37.54852Z\",\"updated_at\":\"2026-04-18T17:07:51.941586Z\",\"genres\":[\"Adventure\",\"Animation\",\"Comedy\",\"Family\"],\"file_path\":\"\"},{\"id\":2332,\"library_id\":1,\"type\":\"movie\",\"title\":\"Zoolander 2\",\"sort_title\":\"Zoolander 2\",\"year\":2016,\"overview\":\"Derek and Hanse"
    },
    {
      "header": {
        "logLevel": "INFO",
