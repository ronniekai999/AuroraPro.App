<?xml version="1.0" encoding="utf-8"?>
<!--
    Square launcher icon — used by android:icon and android:roundIcon in
    the manifest. Separate from tv_banner.xml because the banner is wide
    (320×180) and the icon is square (108×108).

    For a Leanback-only app this icon is rarely seen on-device — Android TV
    launchers use the banner. But it surfaces in: Android Studio's app
    preview, the device's Settings > Apps screen, the Play Store listing,
    and any phone-style launcher that happens to render the app.

    No wordmark — at 108dp the letters of "AURORA" would be illegible. Just
    the play-mark on the same violet gradient as the banner, so the two
    surfaces read as one brand identity.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Solid base -->
    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z"
        android:fillColor="#0A0E17" />

    <!-- Diagonal violet gradient — same direction as the banner -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"   android:startY="0"
                android:endX="108"   android:endY="108"
                android:startColor="#A06D28D9"
                android:centerColor="#508B5CF6"
                android:endColor="#000A0E17" />
        </aapt:attr>
    </path>

    <!-- Aurora mark — circle + play triangle, centered, in violet -->
    <path
        android:pathData="M 54 54 m -32 0 a 32 32 0 1 0 64 0 a 32 32 0 1 0 -64 0"
        android:strokeColor="#A78BFA"
        android:strokeWidth="4" />
    <path
        android:pathData="M 44 36 L 76 54 L 44 72 Z"
        android:fillColor="#A78BFA" />
</vector>
