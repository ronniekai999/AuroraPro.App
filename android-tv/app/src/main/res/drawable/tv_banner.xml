<?xml version="1.0" encoding="utf-8"?>
<!--
    Leanback launcher banner — 320×180 vector. Scales to whatever density
    the host TV launcher renders at (typically 192×108 dp on Shield, 240×135
    dp on Chromecast with Google TV).

    The launcher renders the app's android:label ("Aurora") underneath this
    tile. The wordmark inside the banner exists for visual brand presence,
    not as the readable name — same convention as Plex / Apple TV+ / Disney+.

    Letter construction: each glyph is built from rectilinear filled paths
    (no curves). VectorDrawable supports Q/C curves, but curves balloon the
    path data and make iteration painful. Block letters read clearly at the
    sizes the launcher actually renders at, and keep the file under 4KB.

    Phase 1 swaps this vector for a designer-supplied PNG/WebP with proper
    typography and richer artwork.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Layer 1: Solid base. Guarantees an opaque dark fill even on TV
         firmwares with quirky gradient rendering. -->
    <path
        android:pathData="M0,0 L320,0 L320,180 L0,180 Z"
        android:fillColor="#0A0E17" />

    <!-- Layer 2: Diagonal violet gradient. AccentDeep → AccentBold → bg.
         Top-left bright, bottom-right fading into the base — same hue
         direction as the sign-in screen's painted backdrop. -->
    <path android:pathData="M0,0 L320,0 L320,180 L0,180 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"   android:startY="0"
                android:endX="320"   android:endY="180"
                android:startColor="#A06D28D9"
                android:centerColor="#508B5CF6"
                android:endColor="#000A0E17" />
        </aapt:attr>
    </path>

    <!-- Layer 3: Teal corner glow — the aurora-borealis nod, bottom-right. -->
    <path android:pathData="M0,0 L320,0 L320,180 L0,180 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="290"
                android:centerY="160"
                android:gradientRadius="120"
                android:startColor="#6014B8A6"
                android:endColor="#0014B8A6" />
        </aapt:attr>
    </path>

    <!-- Layer 4: Aurora mark. Circle stroke + play triangle, both violet.
         Center (54, 90), radius 40, stroke 4. Triangle is intentionally
         offset right (apex past geometric center) so it appears optically
         centered — same trick we use in core:ui/AuroraMark.kt. -->
    <path
        android:pathData="M 54 90 m -40 0 a 40 40 0 1 0 80 0 a 40 40 0 1 0 -80 0"
        android:strokeColor="#A78BFA"
        android:strokeWidth="4" />
    <path
        android:pathData="M 42 68 L 82 90 L 42 112 Z"
        android:fillColor="#A78BFA" />

    <!-- Layer 5: "AURORA" wordmark. Each letter sits in a 20×28 cell with
         4px spacing. White, fills only (no strokes), to read clearly at
         the launcher's downsampled render size. Cells start at x=120 so
         the wordmark lives right of the mark with breathing room. -->

    <!-- A (cell x=120, y=76) — two slanting legs meeting at apex + crossbar -->
    <path android:fillColor="#FFFFFF"
          android:pathData="M129,76 L131,76 L139,104 L136,104 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M129,76 L131,76 L124,104 L121,104 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M124,93 L136,93 L135,96 L125,96 Z" />

    <!-- U (cell x=144) — two parallel verticals + bottom connector -->
    <path android:fillColor="#FFFFFF"
          android:pathData="M145,76 L148,76 L148,101 L145,101 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M160,76 L163,76 L163,101 L160,101 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M145,101 L163,101 L163,104 L145,104 Z" />

    <!-- R (cell x=168) — vertical bar + bowl rectangle + diagonal leg -->
    <path android:fillColor="#FFFFFF"
          android:pathData="M169,76 L172,76 L172,104 L169,104 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M172,76 L184,76 L184,79 L172,79 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M184,76 L187,76 L187,88 L184,88 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M172,88 L187,88 L187,91 L172,91 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M179,91 L182,91 L187,104 L184,104 Z" />

    <!-- O (cell x=192) — four-sided rectangular ring -->
    <path android:fillColor="#FFFFFF"
          android:pathData="M193,76 L211,76 L211,79 L193,79 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M193,101 L211,101 L211,104 L193,104 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M193,79 L196,79 L196,101 L193,101 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M208,79 L211,79 L211,101 L208,101 Z" />

    <!-- R (cell x=216) — second R, identical construction -->
    <path android:fillColor="#FFFFFF"
          android:pathData="M217,76 L220,76 L220,104 L217,104 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M220,76 L232,76 L232,79 L220,79 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M232,76 L235,76 L235,88 L232,88 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M220,88 L235,88 L235,91 L220,91 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M227,91 L230,91 L235,104 L232,104 Z" />

    <!-- A (cell x=240) — second A, identical construction -->
    <path android:fillColor="#FFFFFF"
          android:pathData="M249,76 L251,76 L259,104 L256,104 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M249,76 L251,76 L244,104 L241,104 Z" />
    <path android:fillColor="#FFFFFF"
          android:pathData="M244,93 L256,93 L255,96 L245,96 Z" />
</vector>
