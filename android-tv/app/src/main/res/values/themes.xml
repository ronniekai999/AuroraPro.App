<resources>
    <!--
        Android-level theme; overridden almost immediately by Compose's AuroraTheme.
        windowBackground matches bg-primary so the system's pre-Compose surface
        doesn't flash a different color during activity startup (cold-start KPI).
    -->
    <style name="Theme.AuroraTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
