# macOS metadata
.DS_Store
**/.DS_Store

# Local dev artifacts
*.log
logs/
screenshots/
# Deep-debug audit report — generated working artifact, kept local
DEEP_DEBUG_AUDIT.md

# Built binaries
/aurora
/cmd/aurora/aurora

# Environment / secrets
.env
.env.local
*.env.bak

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# Frontend build output (rebuilt on each install + redeploy)
#
# static/v2/ is the Vite build output. Every install.sh / redeploy.sh
# run regenerates it via `npm run build`. Tracking it caused painful
# git-pull conflicts: an operator's local clone always has a freshly-
# rebuilt v2/ that differs from whatever CI/other-devs committed.
# Untracked + gitignored, the directory is purely a per-deploy
# artifact.
static/redesign/app/dist/
static/redesign/app/node_modules/
static/v2/

# The rule above is path-specific, so anything that runs npm/npx from a
# directory other than static/redesign/app leaves an UNTRACKED node_modules
# behind — a tool resolving upward from a worktree does exactly that, and the
# result is either repo-noise or, worse, someone committing it. These are
# unanchored on purpose: never track a dependency or bundler cache, wherever
# it lands.
node_modules/
.vite/

# Go build cache (in case anyone runs builds in-tree)
/tmp/

# Claude Code local (machine-specific) settings — keep personal
.claude/settings.local.json

# Adversarial-review records (scripts/record-review.sh) are deliberately
# NOT ignored. scripts/review-gate-ci.sh reads them from a CI checkout,
# where untracked files do not exist, so they have to be committed. Since
# committing one moves HEAD, both gates resolve the reviewed commit by
# walking back over record-only commits — otherwise recording a review
# would itself need a review, forever.
