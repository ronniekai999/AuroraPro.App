{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/review-gate.sh\"",
            "timeout": 15,
            "statusMessage": "Checking adversarial review gate"
          }
        ]
      }
    ]
  }
}
