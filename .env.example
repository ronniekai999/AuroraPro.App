# Aurora Media Server Configuration
# Copy this to .env and modify values

# Server
AURORA_HOST=0.0.0.0
AURORA_PORT=8484

# Database (REQUIRED — change the password!)
POSTGRES_PASSWORD=change-me-to-a-strong-password
# Note: When using docker-compose, DATABASE_URL is constructed automatically
# from POSTGRES_PASSWORD. For standalone usage, set it explicitly:
# DATABASE_URL=postgres://aurora:yourpassword@localhost:5432/aurora?sslmode=disable

# Docker host port for PostgreSQL (default: 5432)
DB_PORT=5432

# Path to your media files on the host
MEDIA_PATH=/path/to/your/media

# Aurora version tag for Docker image (default: dev)
AURORA_VERSION=dev

# Auth — leave JWT_SECRET unset for auto-generation, or set explicitly:
# JWT_SECRET=$(openssl rand -hex 32)
# JWT_SECRET=

# CORS & WebSocket allowed origins (comma-separated)
AURORA_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8484

# Token expiry
ACCESS_TOKEN_MINUTES=5
REFRESH_TOKEN_DAYS=30

# Scanner
SCANNER_WORKERS=8
FFPROBE_PATH=ffprobe
WATCH_DEBOUNCE_MS=2000

# Database pool
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# TMDB Metadata (REQUIRED — get a free key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your-tmdb-api-key-here
METADATA_REFRESH_HOURS=168  # Re-check stale metadata every 7 days

# Cache directories
CACHE_IMAGE_DIR=/var/cache/aurora/images
CACHE_TRANSCODE_DIR=/var/cache/aurora/transcode
CACHE_SUBTITLE_DIR=/var/cache/aurora/subtitles

# Transcoding (Phase 3)
TRANSCODE_MAX_SESSIONS=0          # Max concurrent transcode sessions (0 = unlimited)
TRANSCODE_HW_ACCEL=auto           # "auto", "none", "nvenc", "qsv", "vaapi", "amf"
TRANSCODE_SESSION_TIMEOUT_SEC=120 # Kill idle sessions after N seconds
TRANSCODE_SEGMENT_DURATION=6      # HLS segment length in seconds
TRANSCODE_PROFILES=1080p,720p,480p  # Enabled quality profiles (comma-separated)
