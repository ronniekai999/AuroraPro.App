[Unit]
Description=Aurora Media Server — Auto-updater (one-shot)
Documentation=https://github.com/aurora-media/aurora
# Make sure the network's up before we git-fetch.
After=network-online.target
Wants=network-online.target
# Avoid racing the aurora service's own first-run migrations.
After=aurora.service

[Service]
# oneshot = run to completion, then exit. systemd treats the next
# invocation as a fresh start, so the timer's 5-min cadence works
# naturally without the unit being in a "running" loop state.
Type=oneshot
# 2026-05-20 — explicitly set HOME=/root. systemd doesn't propagate
# HOME for system services by default; without this, `git` operations
# that touch config files (credential.helper=store, git config --get,
# etc.) hit `fatal: unable to set up default path; use --file`.
# install.sh's credential.helper config also uses the explicit
# --file=/root/.git-credentials form for defense-in-depth, but
# setting HOME here covers any future git config lookups too.
Environment=HOME=/root
ExecStart=/usr/local/bin/aurora-update
# 20-minute cap (was 10). A clean build on modest hardware is ~30s,
# a cold one a few minutes, but a run also waits up to 5 minutes for
# viewers to finish and then verifies the restarted service (up to
# ~100 s, and as long again for a rollback). The cap exists so a hung
# git fetch or runaway build can't camp on the system.
TimeoutStartSec=20min
# After that SIGTERM, how long a rollback in progress may take before systemd
# sends SIGKILL: the updater ignores TERM while it rolls back, and a rollback's
# restart and verification can need about two minutes. The default (90 s)
# could cut it off between two renames.
TimeoutStopSec=5min

# Logging: stdout/stderr go to journalctl (per-invocation), and
# the script also tees to /var/log/aurora/update.log for the
# human-readable rolling log the admin UI links to.
StandardOutput=journal
StandardError=journal

# This service legitimately needs full root: it writes
# /usr/local/bin/aurora (a system-wide binary) and calls
# `systemctl restart aurora`. Don't apply hardening sandboxes
# here — they'd just block the legitimate writes.

[Install]
# Not auto-started on boot — the timer is. WantedBy here is just
# so `systemctl enable aurora-update.service` doesn't error out
# if an operator runs it manually for some reason.
WantedBy=multi-user.target
