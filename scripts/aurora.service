[Unit]
Description=Aurora Media Server
Documentation=https://github.com/aurora-media/aurora
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=aurora
Group=aurora

WorkingDirectory=/opt/aurora
ExecStart=/usr/local/bin/aurora
EnvironmentFile=-/etc/aurora/aurora.env

Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# A stop waits for a running database restore (up to 4 minutes, then the
# server stops it): one killed part way leaves the database empty. For that
# wait to mean anything the stop's SIGTERM must reach the server alone, not
# the restore's psql and pg_restore beside it (the default, control-group,
# sends it to every process in the unit, and pg_restore cancels its own query
# on SIGTERM), and systemd must not SIGKILL the unit first (the default
# TimeoutStopSec is 90 s). With mixed, whatever is left when the server exits
# gets SIGKILL; the server stops its transcodes itself on the way out.
KillMode=mixed
TimeoutStopSec=5min

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
# read-only allows scanning media libraries stored under /home/
ProtectHome=read-only
PrivateTmp=yes
# /var/lib/aurora is included so aurora can touch the
# /var/lib/aurora/trigger-update file used by aurora-update.path
# to trigger the in-app "Update Now" button without sudo.
ReadWritePaths=/var/cache/aurora /opt/aurora /var/log/aurora /var/lib/aurora

[Install]
WantedBy=multi-user.target
