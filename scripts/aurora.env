# Aurora Media Server - Environment Configuration
# Copy this file to /etc/aurora/aurora.env and fill in the values.
#
# IMPORTANT — comments must be on their OWN LINE. systemd reads this file via
# EnvironmentFile= (scripts/aurora.service) and has NO inline-comment support:
# it keeps everything after the `=`, stripping only trailing whitespace. So
#
#     BUG_REPORT_PUBLIC_BASE_URL=https://aurora.example.com   # no trailing slash
#
# sets the value to `https://aurora.example.com   # no trailing slash`, comment
# and all. Several tunables below carry an explanatory `# ...` after the value
# BECAUSE THE WHOLE LINE IS COMMENTED OUT; if you uncomment one, delete the
# annotation too.
#
# This bites hardest where a wrong value is accepted silently rather than
# rejected: BUG_REPORT_PUBLIC_BASE_URL filed months of issues with dead
# attachment links (fixed in config.go, which now cuts such comments and logs
# an error), and LLM_EMBED_MODEL would change EmbedSpaceID, nulling every
# stored vector and forcing a full re-embed. The integer tunables fail safe —
# they log a WARN and use the default.
#
# The shell disagrees with systemd here, which is what makes this hard to spot:
# scripts/aurora-update.sh sources this file with `set -a; . file`, and POSIX
# shell DOES drop ` # comment`. Sourcing it to debug shows a clean value while
# the running server sees the comment.

# PostgreSQL connection string
DATABASE_URL=postgres://aurora:aurora@localhost:5432/aurora?sslmode=disable

# JWT signing secret (64+ characters). install.sh auto-generates this when it
# writes /etc/aurora/aurora.env; set it yourself if copying this sample manually.
JWT_SECRET=

# TheMovieDB API key (optional — Aurora ships with a bundled application
# key; set this only to use your own) - https://www.themoviedb.org/settings/api
# TMDB_API_KEY=

# TheTVDB credentials (optional — a bundled project key enables the TV
# fallback out of the box; override the key, add your subscriber PIN,
# or set TVDB_ENABLED=false to opt out)
# TVDB_API_KEY=
# TVDB_PIN=
# TVDB_ENABLED=false

# Cache directories
CACHE_IMAGE_DIR=/var/cache/aurora/images
CACHE_TRANSCODE_DIR=/var/cache/aurora/transcode
CACHE_SUBTITLE_DIR=/var/cache/aurora/subtitles

# CORS allowed origins (comma-separated)
AURORA_ALLOWED_ORIGINS=http://localhost:*,https://localhost:*

# Force the Secure attribute on auth cookies. install.sh sets this
# automatically when a domain fronts the install — TLS terminates at
# nginx, so the Go server sees plain HTTP and can't infer it.
# AURORA_SECURE_COOKIES=true

# Watch-party voice ICE servers. The default public STUN covers most
# home NATs; behind CGNAT / symmetric NAT, run a TURN relay (coturn)
# and point these at it.
# AURORA_VOICE_STUN_SERVERS=stun:stun.l.google.com:19302
# AURORA_TURN_URL=turn:turn.example.com:3478
# AURORA_TURN_USERNAME=
# AURORA_TURN_CREDENTIAL=

# Requests integration — separate 4K instances (optional, in addition
# to RADARR_URL / SONARR_URL).
# RADARR_4K_URL=
# RADARR_4K_API_KEY=
# SONARR_4K_URL=
# SONARR_4K_API_KEY=

# Auto-updater supply-chain hardening (deep-debug H12). The updater builds and
# installs fetched code as root, so its provenance matters:
#  - It ALWAYS refuses plaintext (http:// / git://) origins.
#  - AURORA_UPDATE_REQUIRE_SIGNED=true makes it REQUIRE the fetched commit to be
#    signed by a trusted key before building (default false so unsigned repos
#    keep updating, with a loud warning in the update log). Requires signed
#    releases + a trust root, configured one of two ways:
#  - AURORA_UPDATE_ALLOWED_SIGNERS=/path/to/allowed_signers  (SSH signing), or
#    import the maintainer's GPG public key into root's keyring (GPG signing).
#    NOTE (GPG path): git verify-commit trusts ANY key in root's keyring (even
#    at "unknown" ownertrust), so keep that keyring limited to the maintainer
#    key only. The SSH allowed_signers path is scoped to the listed keys and is
#    preferred where possible.
# AURORA_UPDATE_REQUIRE_SIGNED=false
# AURORA_UPDATE_ALLOWED_SIGNERS=

# Logging
LOG_DIR=/var/log/aurora
LOG_LEVEL=info
# LOG_MAX_SIZE_MB=100
# LOG_MAX_BACKUPS=5
# LOG_MAX_AGE_DAYS=30
# LOG_COMPRESS=true

# Transcoding (optional)
# TRANSCODE_HW_ACCEL=auto
# TRANSCODE_MAX_SESSIONS=0
# TRANSCODE_PROFILES=1080p,720p,480p

# In-app "Report a Bug" feature (optional, off by default).
# When enabled, authed users get a launcher in the bottom-left that
# opens a modal to file a GitHub issue (with optional screenshot or
# 30s screen recording). See docs/bug-report-setup.md for the PAT
# generation walkthrough.
# BUG_REPORT_ENABLED=false
# BUG_REPORT_GITHUB_TOKEN=
# BUG_REPORT_GITHUB_REPO=your-org/aurora-bug-reports
# BUG_REPORT_PUBLIC_BASE_URL=https://aurora.example.com
#
# Operational tunables (all optional; defaults shown). Each accepts a
# positive integer; invalid values fall back to the default.
# BUG_REPORT_RATE_LIMIT_MAX=5                # max submits per user per window
# BUG_REPORT_RATE_LIMIT_WINDOW_HOURS=1       # rate-limit window length
# BUG_REPORT_ATTACHMENT_TTL_DAYS=30          # janitor: delete attachments older than this
# BUG_REPORT_JANITOR_INTERVAL_HOURS=1        # janitor: how often to sweep

# Semantic search / LLM (Ollama) — all optional; defaults shown.
# The AI stack is on by default and degrades gracefully to keyword
# search when Ollama is unreachable. install.sh writes LLM_OLLAMA_URL
# explicitly; the rest are code defaults you can override here.
# Provider/model/URL settings saved in the admin UI (Admin → LLM) are
# stored in the database and take precedence over these on restart.
# LLM_ENABLED=true
# LLM_OLLAMA_URL=http://localhost:11434
# 1024-dim MRL, stored truncated to 768. Annotation kept off the value line:
# a `#` surviving into this one changes EmbedSpaceID, which nulls every stored
# vector and forces a full re-embed.
# LLM_EMBED_MODEL=qwen3-embedding:0.6b
# query parsing / rerank / curation
# LLM_CHAT_MODEL=qwen3:4b-instruct
# LLM_EMBED_DIMS=768                        # must match the vector(768) column
# LLM_BACKFILL_WORKERS=2                    # parallel embedding backfill goroutines
# LLM_BACKFILL_BATCH=16                     # items per Ollama embed call
# LLM_HTTP_TIMEOUT_SEC=70                   # per-request ceiling (> per-call budgets)
# LLM_NUM_CTX=0                             # >0 sends options.num_ctx on native chat calls

# AI re-matching of low-confidence TMDB matches (needs the LLM stack).
# AI_MATCH_AUTO_THRESHOLD=90                # LLM confidence floor for auto-promote
# AI_MATCH_RATE_PER_SEC=1.0                 # background backfill throttle
